		<PackageReference Include="Grpc.AspNetCore" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
		<PackageReference Include="MongoDB.Bson" />
		<PackageReference Include="MongoDB.Driver" />
		<PackageReference Include="RabbitMQ.Client" />
		<PackageReference Include="Serilog" />
		<PackageReference Include="Serilog.AspNetCore" />
		<PackageReference Include="Swashbuckle.AspNetCore" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Common\Core\Challenge.Common.Core.Cqrs\Challenge.Common.Core.Cqrs.csproj" />
		<ProjectReference Include="..\..\Common\Core\Challenge.Common.Core.Response\Challenge.Common.Core.Response.csproj" />
		<ProjectReference Include="..\..\Common\Core\Challenge.Common.Core.Validation\Challenge.Common.Core.Validation.csproj" />
		<ProjectReference Include="..\..\Common\Data\Challenge.Common.Data.Mongo\Challenge.Common.Data.Mongo.csproj" />
		<ProjectReference Include="..\..\Common\Data\Challenge.Common.Data\Challenge.Common.Data.csproj" />
		<ProjectReference Include="..\..\Common\Messaging\Challenge.Common.Messaging.Grpc\Challenge.Common.Messaging.Grpc\Challenge.Common.Messaging.Grpc.csproj" />
	</ItemGroup>

</Project>